# 三个槽位分别配置，互不影响
EMBED_MODEL=embedding-3
EMBED_DIM=1024                  # 建议先用 1024，够用且省一半存储

RERANK_PROVIDER=zhipu           # zhipu | none
RERANK_MODEL=rerank

LLM_PROVIDER=zhipu              # zhipu | deepseek
LLM_MODEL=GLM-4.7-Flash

ZHIPU_API_KEY=
DEEPSEEK_API_KEY=

VAULT_ROOT=/Users/yourname/Documents/ObsidianVault
DB_PATH=.data/rag.db